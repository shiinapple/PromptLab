{
  "name": "prompt-practice-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
