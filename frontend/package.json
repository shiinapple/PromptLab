    "build": "vite build"
  },
  "dependencies": {
    "eventsource-parser": "3.0.8",
    "vue": "3.5.46",
    "vue-i18n": "11.4.24"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.11",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  }
}
