{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "name",
    "reply"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "\\S"
    },
    "reply": {
      "type": "string",
      "pattern": "\\S"
    },
    "in_character": {}
  }
}
